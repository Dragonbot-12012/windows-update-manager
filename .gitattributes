* text=auto

# Keep line endings predictable across platforms
.gitattributes text eol=lf
.gitignore     text eol=lf
LICENSE        text eol=lf
*.md           text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.json         text eol=lf
*.ps1          text eol=crlf
*.vbs          text eol=crlf

# Binaries
*.png   binary
*.ico   binary
*.webp  binary
*.exe   binary
